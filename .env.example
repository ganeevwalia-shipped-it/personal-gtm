# === API Keys ===
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# === Google Sheets ===
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Create a Service Account, download the JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# The tab name in your sheet that has your content calendar
GOOGLE_SHEET_TAB=Content Calendar

# === Notion ===
# Get from: https://www.notion.so/my-integrations → Create new integration
NOTION_API_KEY=ntn_...

# The database ID from your Notion database URL
# Open database as full page → URL looks like: notion.so/{workspace}/{DATABASE_ID}?v=...
NOTION_DATABASE_ID=your-database-id-here
